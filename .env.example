# ============================================================
# Smart Farmer Assistance & Crop Management System
# Environment Variables Example
# Copy this file to .env and fill in your actual values
# ============================================================

# Django Core Settings
SECRET_KEY=your-very-secret-key-change-this-in-production-make-it-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Database Configuration
# For local development, SQLite is the default and requires no running database service.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Optional MySQL settings if you prefer MySQL for local or production work.
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=3306

# Email / Gmail SMTP settings for contact form notifications
# Use a Gmail App Password, not your normal account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Weather API
# This project uses Open-Meteo (https://open-meteo.com/)
# Open-Meteo is 100% free and requires NO API key.
# No weather API key is needed — weather will work out of the box.

# Media & Static Files
# These are configured automatically in settings.py
# No additional configuration needed for local development
